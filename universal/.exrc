"higlight text on search
set hlsearch incsearch

"add number to the vim gutter
set nu rnu

"setup search behaviour to be case-insensitive
set ignorecase
set smartcase

imap jk <Esc>
imap kj <Esc>

" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
set scrolloff=999
