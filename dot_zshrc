function le() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    command yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
}

# Set up fzf key bindings and fuzzy completion
# export FZF_DEFAULT_OPTS='--height 40% --tmux bottom,40% --layout reverse --border top'
export FZF_DEFAULT_OPTS="--tmux center"
source <(fzf --zsh)
source /opt/fzf-git/fzf-git.sh

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"

# Auto-attach to a per-host tmux session only if it isn't already attached
# https://wiki.archlinux.org/title/Tmux#Session_initialization
if [ -x "$(command -v tmux)" ] && [ -z "${TMUX}" ]; then
    # replace `.` with `_` if there's any because tmux doesn't allow `.` in session names
    session="$(hostname | tr . _)"
    attached="$(tmux list-sessions -F '#{session_name} #{session_attached}' 2>/dev/null | awk -v s="$session" '$1==s {print $2}')"
    
    if [ -z "$attached" ] || [ "$attached" = "0" ]; then

        if [ -x "$(command -v wezterm)" ]; then
            wezterm cli set-tab-title "$session"
        fi

        tmux new-session -A -s "$session" >/dev/null 2>&1
    fi
fi

